<Window x:Class="K2ModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:K2ModManager"
        Title="Kohan II Mod Manager" Icon="K2ModManager.ico" Width="960" Height="640" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" FontSize="14" Foreground="{DynamicResource Ink}"
        Background="{DynamicResource Paper}" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
  <Grid>
    <DockPanel>
      <Border DockPanel.Dock="Top" Background="{StaticResource Header}" Padding="20,14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Button Style="{StaticResource Link}" Content="Change game folder..." Click="OnChangeGame" HorizontalAlignment="Right" />
            <Button Style="{StaticResource Link}" Content="For mod authors: make a package..." Click="OnAuthor" HorizontalAlignment="Right" Margin="0,6,0,0" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Kohan II Mod Manager" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource GoldText}" />
            <TextBlock x:Name="GameText" Foreground="#B8C4DE" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
            <local:FingerprintBar x:Name="FilesBar" Margin="0,3,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border DockPanel.Dock="Bottom" Background="{DynamicResource Footer}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
        <DockPanel>
          <Button x:Name="PlayButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Play Kohan II" Click="OnPlay" Margin="0" />
          <CheckBox x:Name="AutosaveBox" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,20,0" Click="OnAutosave"
                    ToolTip="When you host, the match is saved every few minutes as &quot;MP Autosave A&quot; and &quot;B&quot;. If someone's game crashes, host again and pick the newest one under Load saved game. Starts the next time you open Kohan II.">
            <TextBlock x:Name="AutosaveText" Text="Autosave multiplayer games" />
          </CheckBox>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="AddButton" Content="Add a mod..." Click="OnAdd" FontWeight="SemiBold" />
            <TextBlock Text="or drag a mod file onto this window" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <StackPanel x:Name="NoticePanel" DockPanel.Dock="Top" Margin="20,12,20,0" />

      <Grid Margin="20,12,20,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="5*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
          <TextBlock DockPanel.Dock="Top" Text="Your mods" FontSize="18" FontWeight="SemiBold" />
          <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,8"
                     Text="Tick a mod to play with it. If two ticked mods change the same thing, the one lower in the list wins." />
          <StackPanel x:Name="PluginPanel" DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock Text="Game plugins" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,8"
                       Text="Plugins change how the game program itself works. They are not part of the multiplayer version check." />
            <ItemsControl x:Name="PluginList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10,8" Margin="0,0,0,6">
                    <DockPanel>
                      <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Click="OnPluginToggle" VerticalAlignment="Center" Margin="0,0,12,0">
                        <CheckBox.LayoutTransform>
                          <ScaleTransform ScaleX="1.35" ScaleY="1.35" />
                        </CheckBox.LayoutTransform>
                      </CheckBox>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Version}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                        <TextBlock Text="{Binding Status}" FontSize="12.5" TextWrapping="Wrap">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource StatusOk}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Off"><Setter Property="Foreground" Value="{DynamicResource StatusOff}" /></DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Warn"><Setter Property="Foreground" Value="{DynamicResource StatusWarn}" /></DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Bad"><Setter Property="Foreground" Value="{DynamicResource StatusBad}" /></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="UpButton" Content="Move up" Click="OnUp" />
            <Button x:Name="DownButton" Content="Move down" Click="OnDown" />
          </StackPanel>
          <Grid>
            <ListBox x:Name="ModList" SelectionChanged="OnSelect" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="10,8" />
                  <Setter Property="BorderBrush" Value="{DynamicResource RowLine}" />
                  <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                  <Setter Property="BorderThickness" Value="0,0,0,1" />
                  <!-- own highlight: Windows' selected row is a fixed light grey with a white edge, wrong in dark mode -->
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource RowHover}" />
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource RowSelected}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Click="OnToggle" VerticalAlignment="Center" Margin="0,0,12,0">
                      <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="1.35" ScaleY="1.35" />
                      </CheckBox.LayoutTransform>
                    </CheckBox>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Version}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Status}" FontSize="12.5" TextWrapping="Wrap">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource StatusOk}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding StatusKind}" Value="Off"><Setter Property="Foreground" Value="{DynamicResource StatusOff}" /></DataTrigger>
                              <DataTrigger Binding="{Binding StatusKind}" Value="Warn"><Setter Property="Foreground" Value="{DynamicResource StatusWarn}" /></DataTrigger>
                              <DataTrigger Binding="{Binding StatusKind}" Value="Bad"><Setter Property="Foreground" Value="{DynamicResource StatusBad}" /></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Foreground="{DynamicResource Muted}" FontSize="15" TextWrapping="Wrap" Margin="24"
                       Text="No mods yet.&#x0a;Click &quot;Add a mod...&quot; below and pick the mod file you downloaded." />
          </Grid>
        </DockPanel>

        <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="16">
          <DockPanel x:Name="Details">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
              <Button x:Name="RemoveButton" Content="Remove this mod" Click="OnRemove" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Top">
              <TextBlock x:Name="DTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock x:Name="DByline" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
              <TextBlock x:Name="DWebsite" Margin="0,4,0,0" TextWrapping="Wrap">
                <Hyperlink x:Name="DLink" RequestNavigate="OnLink"><Run x:Name="DLinkText" /></Hyperlink>
              </TextBlock>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
              <StackPanel>
                <TextBlock x:Name="DDescription" TextWrapping="Wrap" />
                <TextBlock x:Name="DFacts" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,12,0,0" />
                <TextBlock x:Name="DConflicts" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource StatusWarn}" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </DockPanel>

    <Border x:Name="Busy" Background="#B0081028" Visibility="Collapsed">
      <Border Background="{DynamicResource Panel}" CornerRadius="8" Padding="28,22" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="360">
        <StackPanel>
          <TextBlock x:Name="BusyText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="520" />
          <ProgressBar IsIndeterminate="True" Height="6" Margin="0,14,0,0" />
          <TextBlock x:Name="BusyDetail" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" MaxWidth="520" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
