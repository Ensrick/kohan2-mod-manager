<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>K2ModManager</AssemblyName>
    <RootNamespace>K2ModManager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>K2ModManager.ico</ApplicationIcon>
    <Version>0.1.0-beta.5</Version>
    <Product>Kohan II Mod Manager</Product>
    <AssemblyTitle>Kohan II Mod Manager</AssemblyTitle>
    <Copyright>Copyright (c) 2026 Ensrick. MIT License.</Copyright>
    <Nullable>disable</Nullable>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Windows.Forms" />
    <Resource Include="K2ModManager.ico" />
  </ItemGroup>
  <!-- Game plugins (native/, built by native\build.ps1). Left out when they have not been built: the manager then lists no plugins. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\native\build\Release\winmm.dll" LogicalName="plugins.winmm.dll" Condition="Exists('..\..\native\build\Release\winmm.dll')" />
    <EmbeddedResource Include="..\..\native\build\Release\k2mp.dll" LogicalName="plugins.k2mp.dll" Condition="Exists('..\..\native\build\Release\k2mp.dll')" />
  </ItemGroup>
</Project>
