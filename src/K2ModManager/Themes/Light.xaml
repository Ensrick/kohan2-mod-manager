<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Neutral colours for Windows' light app mode. Blue and gold live in App.xaml and do not change. -->
  <SolidColorBrush x:Key="Ink" Color="#2B2116" />
  <SolidColorBrush x:Key="Muted" Color="#6B5E4B" />
  <SolidColorBrush x:Key="Paper" Color="#F6F1E7" />
  <SolidColorBrush x:Key="Panel" Color="#FFFDF8" />
  <SolidColorBrush x:Key="Field" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Line" Color="#D9CDB6" />
  <SolidColorBrush x:Key="RowLine" Color="#EDE4D3" />
  <SolidColorBrush x:Key="RowHover" Color="#142050B0" />
  <SolidColorBrush x:Key="RowSelected" Color="#2E2050B0" />
  <SolidColorBrush x:Key="Footer" Color="#EAE1CF" />
  <SolidColorBrush x:Key="LinkText" Color="#1F5FB8" />
  <SolidColorBrush x:Key="ScrollThumb" Color="#C9BFAE" />
  <SolidColorBrush x:Key="ScrollThumbHover" Color="#A99D88" />

  <SolidColorBrush x:Key="StatusOk" Color="#3C7A3A" />
  <SolidColorBrush x:Key="StatusOff" Color="#8A7E6A" />
  <SolidColorBrush x:Key="StatusWarn" Color="#9A6510" />
  <SolidColorBrush x:Key="StatusBad" Color="#A8322A" />

  <SolidColorBrush x:Key="NoticeInfo" Color="#DDEBD7" />
  <SolidColorBrush x:Key="NoticeInfoEdge" Color="#A9C79E" />
  <SolidColorBrush x:Key="NoticeWarn" Color="#FBF0CC" />
  <SolidColorBrush x:Key="NoticeWarnEdge" Color="#E2C67A" />
  <SolidColorBrush x:Key="NoticeError" Color="#F8DDD6" />
  <SolidColorBrush x:Key="NoticeErrorEdge" Color="#D9A196" />
</ResourceDictionary>
