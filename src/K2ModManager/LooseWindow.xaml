<Window x:Class="K2ModManager.LooseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pack a hand-installed mod" Icon="K2ModManager.ico" Width="720" Height="640" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="14" Foreground="{DynamicResource Ink}" Background="{DynamicResource Paper}">
  <Grid>
    <DockPanel Margin="20,16">
      <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="Pack a hand-installed mod" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="Intro" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,4,0,12" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="70" />
            <ColumnDefinition Width="140" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Name" VerticalAlignment="Center" />
          <TextBox x:Name="NameBox" Grid.Column="1" TextChanged="OnNameChanged" />
          <TextBlock Text="Version" Grid.Column="3" VerticalAlignment="Center" />
          <TextBox x:Name="VersionBox" Grid.Column="4" />
        </Grid>
        <TextBlock x:Name="IdNote" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="13" Margin="70,4,0,0" />
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom">
        <Border BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="0,12,0,0"
                Background="{DynamicResource NoticeWarn}" BorderBrush="{DynamicResource NoticeWarnEdge}">
          <TextBlock x:Name="MpWarning" TextWrapping="Wrap" />
        </Border>
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"
                   Text="The loose files are then moved, not deleted, to a new loose_backup folder next to the folder they are in, so you can put them back later." />
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource StatusBad}" Margin="0,8,0,0" Visibility="Collapsed" />
        <DockPanel Margin="0,14,0,0">
          <Button Content="Open the folder" Click="OnOpenFolder" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="PackButton" Content="Pack and turn on" Style="{StaticResource Primary}" Click="OnPack" IsDefault="True" />
            <Button Content="Cancel" IsCancel="True" Margin="0" />
          </StackPanel>
        </DockPanel>
      </StackPanel>

      <DockPanel Margin="0,12,0,0">
        <TextBlock DockPanel.Dock="Top" Text="Files that will go into the mod" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="FileList" IsReadOnly="True" FontFamily="Consolas" FontSize="12.5" Background="{DynamicResource Panel}"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
      </DockPanel>
    </DockPanel>
  </Grid>
</Window>
