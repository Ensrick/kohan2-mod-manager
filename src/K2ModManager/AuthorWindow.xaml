<Window x:Class="K2ModManager.AuthorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Make a mod package" Icon="K2ModManager.ico" Width="860" Height="760" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner" FontSize="14" Foreground="{StaticResource Ink}" Background="{StaticResource Paper}">
  <Grid>
    <DockPanel Margin="20,16">
      <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="Make a mod package" FontSize="22" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,4,0,12">
          Pick the folder with your finished mod files, laid out like the game's data (Units\, Buildings\, Organizations\ and so on).
          The package holds only your changes: game files you edited become patches against the player's own copy of the game,
          and unchanged game files are left out, so you can share it without sharing the game's files.
        </TextBlock>
        <DockPanel>
          <TextBlock Text="Mod folder" Width="110" VerticalAlignment="Center" />
          <Button DockPanel.Dock="Right" Content="Browse..." Click="OnBrowse" Margin="8,0,0,0" />
          <TextBox x:Name="FolderBox" LostFocus="OnFolderTyped" />
        </DockPanel>
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="8" />
            <RowDefinition />
            <RowDefinition Height="8" />
            <RowDefinition />
          </Grid.RowDefinitions>
          <TextBlock Text="Name" VerticalAlignment="Center" />
          <TextBox x:Name="NameBox" Grid.Column="1" />
          <TextBlock Text="Version" Grid.Column="3" VerticalAlignment="Center" />
          <TextBox x:Name="VersionBox" Grid.Column="4" />
          <TextBlock Text="Author" Grid.Row="2" VerticalAlignment="Center" />
          <TextBox x:Name="AuthorBox" Grid.Row="2" Grid.Column="1" />
          <TextBlock Text="Website" Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" />
          <TextBox x:Name="WebsiteBox" Grid.Row="2" Grid.Column="4" />
          <TextBlock Text="Description" Grid.Row="4" VerticalAlignment="Top" Margin="0,4,0,0" />
          <TextBox x:Name="DescriptionBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" Height="64" TextWrapping="Wrap"
                   AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
        </Grid>
        <Expander Header="More settings (other mods, art based on game files)" Margin="0,10,0,0">
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="210" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition Height="6" />
              <RowDefinition />
              <RowDefinition Height="6" />
              <RowDefinition />
              <RowDefinition Height="6" />
              <RowDefinition />
              <RowDefinition Height="6" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Mod id" VerticalAlignment="Center" />
            <TextBox x:Name="IdBox" Grid.Column="1" ToolTip="Short name used for folders and for other mods to refer to this one: a-z, 0-9, - and _. Leave empty to make one from the name." />
            <TextBlock Text="Cannot be used with (ids)" Grid.Row="2" VerticalAlignment="Center" />
            <TextBox x:Name="IncompatibleBox" Grid.Row="2" Grid.Column="1" ToolTip="Comma-separated mod ids. The manager turns those mods off when this one is turned on." />
            <TextBlock Text="Needs (ids)" Grid.Row="4" VerticalAlignment="Center" />
            <TextBox x:Name="RequiresBox" Grid.Row="4" Grid.Column="1" ToolTip="Comma-separated mod ids that must be installed and on; they load before this mod." />
            <TextBlock Text="Load after (ids)" Grid.Row="6" VerticalAlignment="Center" />
            <TextBox x:Name="LoadAfterBox" Grid.Row="6" Grid.Column="1" ToolTip="Comma-separated mod ids this mod should load after (so its files win)." />
            <TextBlock Grid.Row="8" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,4,8,0"
                       Text="New art painted over a game file (one per line: your file = game file)" />
            <TextBox x:Name="BasesBox" Grid.Row="8" Grid.Column="1" Height="70" AcceptsReturn="True" FontFamily="Consolas" FontSize="12.5"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     ToolTip="Example: Units/Human/MyKnight/MyKnight.dds = Units/Human/Swordsman/swordsmanbase.dds&#x0a;Such files are stored as changes to that game file instead of whole." />
          </Grid>
        </Expander>
        <StackPanel Orientation="Horizontal" Margin="0,14,0,10">
          <Button x:Name="PackButton" Content="Make package (.k2mod)" Style="{StaticResource Primary}" Click="OnPack" Margin="0,0,10,0" />
          <Button x:Name="TestButton" Content="Make and install to test" Click="OnPackAndInstall" />
          <Button x:Name="RwdButton" Content="Make .rwd only" Click="OnRwd" />
        </StackPanel>
      </StackPanel>
      <TextBox x:Name="Log" IsReadOnly="True" FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" Background="{StaticResource Panel}" />
    </DockPanel>
    <Border x:Name="Busy" Background="#80081028" Visibility="Collapsed">
      <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="28,22" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="360">
        <StackPanel>
          <TextBlock x:Name="BusyText" FontSize="16" FontWeight="SemiBold" />
          <ProgressBar IsIndeterminate="True" Height="6" Margin="0,14,0,0" />
          <TextBlock x:Name="BusyDetail" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" MaxWidth="520" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
