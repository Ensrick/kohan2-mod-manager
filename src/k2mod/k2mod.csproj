<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>k2mod</AssemblyName>
    <RootNamespace>K2ModCli</RootNamespace>
    <Version>0.1.0-beta.7</Version>
    <Product>Kohan II Mod Manager</Product>
    <Copyright>Copyright (c) 2026 Ensrick. MIT License.</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>disable</Nullable>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <!-- Game plugins (native/, built by native\build.ps1). Left out when they have not been built: the manager then lists no plugins. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\native\build\Release\avifil32.dll" LogicalName="plugins.avifil32.dll" Condition="Exists('..\..\native\build\Release\avifil32.dll')" />
    <EmbeddedResource Include="..\..\native\build\Release\k2mp.dll" LogicalName="plugins.k2mp.dll" Condition="Exists('..\..\native\build\Release\k2mp.dll')" />
  </ItemGroup>
</Project>
