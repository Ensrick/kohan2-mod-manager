// Version resource, filled in by CMake (configure_file). The manager reads ProductName, FileDescription, Comments,
// ProductVersion and InternalName to list a plugin; ProductName "Kohan II plugin" marks a DLL as one.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @V_MAJOR@,@V_MINOR@,@V_PATCH@,0
 PRODUCTVERSION @V_MAJOR@,@V_MINOR@,@V_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName", "@V_PRODUCT@"
            VALUE "FileDescription", "@V_TITLE@"
            VALUE "Comments", "@V_COMMENTS@"
            VALUE "CompanyName", "Kohan II Mod Manager"
            VALUE "FileVersion", "@V_STRING@"
            VALUE "ProductVersion", "@V_STRING@"
            VALUE "InternalName", "@V_ID@"
            VALUE "OriginalFilename", "@V_FILE@"
            VALUE "LegalCopyright", "Copyright (c) 2026 Ensrick. MIT License."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
